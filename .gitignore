cat <<EOF > .gitignore
# Environments
.venv/
venv/
ENV/
env/


# Python junk
__pycache__/
*.pyc
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints

# Operating System files
.DS_Store
Thumbs.db

# Project-specific exclusions
# Data/Models (Optional - depends if you want them on GitHub)
data/*.csv
models/*.pkl
data/raw/
models/*.joblib
app/.streamlit/
EOF