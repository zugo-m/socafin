    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# Load the mapped data from Sprint 1\n",
    "df = pd.read_csv('../data/german_credit_mapped.csv')\n",
    "\n",
    "# Separate Features (X) and Target (y)\n",
    "X = df.drop('class', axis=1)\n",
    "y = df['class']\n",
    "\n",
    "# Binary Encoding for the Target (0=Good, 1=Bad)\n",
    "# This is crucial for Sprint 4 & 5 metrics (Precision/Recall)\n",
    "y = y.map({'Good Risk': 0, 'Bad Risk': 1})\n",
    "\n",
    "print(f\"Initial Data Shape: {df.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "27131f22",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Encoded Data Shape: (1000, 61)\n"
     ]
    }
   ],
   "source": [
    "# Standardized Numeric Features (Must match preprocess_labels.py)\n",
    "numeric_features = [\n",
    "    'duration', \n",
    "    'credit_amount', \n",
    "    'installment_commitment', \n",
    "    'residence_since', \n",
    "    'age', \n",
    "    'existing_credits', \n",
    "    'num_dependents'\n",
    "]\n",
    "\n",
    "# Create Dummy Variables for all categorical columns\n",
    "X_encoded = pd.get_dummies(X, drop_first=False)\n",
    "\n",
    "# Scaling the Numeric Features\n",
    "scaler = StandardScaler()\n",
    "X_encoded[numeric_features] = scaler.fit_transform(X_encoded[numeric_features])\n",
    "\n",
    "print(f\"Encoded Data Shape: {X_encoded.shape}\") # Should be (1000, 61)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "46554b47",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "------------------------------\n",
      "✅ Preprocessing Complete!\n",
      "Training set: (800, 61)\n",
      "Testing set: (200, 61)\n",
      "------------------------------\n"
     ]
    }
   ],
   "source": [
    "# Splitting into 80% Train and 20% Test\n",
    "# We use 'stratify' to maintain the 70/30 risk ratio in both sets\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_encoded, y, test_size=0.20, random_state=42, stratify=y\n",
    ")\n",
    "\n",
    "print(\"-\" * 30)\n",
    "print(f\"✅ Preprocessing Complete!\")\n",
    "print(f\"Training set: {X_train.shape}\")\n",
    "print(f\"Testing set: {X_test.shape}\")\n",
    "print(\"-\" * 30)"
   ]
  }
 ],
